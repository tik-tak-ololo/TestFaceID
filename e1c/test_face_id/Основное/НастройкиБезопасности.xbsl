@Обработчик
метод ПослеСоздания()
    ИспользоватьFaceID = ПолучитьИспользованиеFaceID(
        КлиентскоеУстройство.ИдКлиента)
;

метод ПереключательFaceIDПриИзменении(Источник: ВыборЗначения<Булево>, Событие: СобытиеПриИзменении<Булево>)
    если Событие.НовоеЗначение
        ВключитьFaceID(Событие.СтароеЗначение)

    иначе
        
        ОтключитьFaceID(Событие.СтароеЗначение)
    ;
;

метод ВключитьFaceID(ПредыдущееЗначение: Булево)
    если не КлиентскоеУстройство.ДоступнаБиометрия
        ИспользоватьFaceID = ПредыдущееЗначение

        выбросить новый ИсключениеВыполнения(
            "На этом устройстве биометрия недоступна. Настройте Face ID в операционной системе.")
    ;

    // При первом включении добавляем устройство в доверенные.
    если не ТекущееУстройствоДоверенное(
        КлиентскоеУстройство.ИдКлиента)
        знч СтатусДобавленияУстройства = ОперацииСамообслуживания.ДобавлениеДоверенногоУстройства()
            .Выполнить()

        ПроверитьСтатусОперации(
            СтатусДобавленияУстройства,
            ПредыдущееЗначение)
    ;

    знч СтатусДобавленияБиометрии = ОперацииСамообслуживания.ДобавлениеБиометрииДоверенногоУстройства()
        .Выполнить()

    ПроверитьСтатусОперации(
        СтатусДобавленияБиометрии,
        ПредыдущееЗначение)

    ИспользоватьFaceID = Истина
;

метод ОтключитьFaceID(ПредыдущееЗначение: Булево)
    знч СтатусУдаленияБиометрии = ОперацииСамообслуживания.УдалениеБиометрииДоверенногоУстройства()
        .Выполнить()

    ПроверитьСтатусОперации(
        СтатусУдаленияБиометрии,
        ПредыдущееЗначение)

    ИспользоватьFaceID = Ложь
;

метод ПроверитьСтатусОперации(СтатусОперации: СтатусОперацииСамообслуживания, ЗначениеПриОшибке: Булево)
    если СтатусОперации.Шаг != ШагОперацииСамообслуживания.ЗавершеноУспешно
        ИспользоватьFaceID = ЗначениеПриОшибке

        выбросить новый ИсключениеВыполнения(
            СтатусОперации.Сообщение)
    ;
;

@НаСервере @ДоступноСКлиента
статический метод ТекущееУстройствоДоверенное(ИдКлиента: Строка): Булево
    знч Пользователь = ПользователиСервиса.ТекущийПользователь

    если Пользователь == Неопределено
        возврат Ложь
    ;

    для ДоверенноеУстройство из Пользователь.ДоверенныеУстройства
        если ДоверенноеУстройство.Ид == ИдКлиента
            возврат Истина
        ;
    ;

    возврат Ложь
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьИспользованиеFaceID(ИдКлиента: Строка): Булево
    знч Пользователь = ПользователиСервиса.ТекущийПользователь

    если Пользователь == Неопределено
        возврат Ложь
    ;

    для ДоверенноеУстройство из Пользователь.ДоверенныеУстройства
        если ДоверенноеУстройство.Ид == ИдКлиента
            возврат ДоверенноеУстройство.ИспользуетсяБиометрия
        ;
    ;

    возврат Ложь
;